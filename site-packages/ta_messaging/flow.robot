*** Settings ***
Library     robot_flow_framework/expect_keyword_listener.py
Library     robot_flow_framework/flows.py
Library     robot_flow_framework/flow_definition.py



*** Variables ***
${common_verifier}=   ${None}
${common_timeout}=      60


*** Keywords ***
EXPECT FLOW${options:(\[.*?\]:|:)} ${device:\S+} ${p:(NG|XN|F1|E1|X2|M3|S1)}AP ${procedure:\S+}${rest_sentence}
    [Documentation]      As procedure following can be used:
    ...                  procedure_x   OR
    ...                  procedure_x,procedure_x   OR
    ...                  procedure_x,procedure_y   OR
    ...                  3*procedure_x   OR
    ...                  3*procedure_x,procedure_y,2*procedure_z
    ...                  Note: procedures may contain multiple messages and their order matters
    ...                  (interleaving of procedures in this keyword is not supported)
    ...                  Note 2: ${common_verifier} variable can be used to apply common verifier (rather python one)
    ...                  Note 3: Set verifiers per message can be used to apply separate verifiers

    set flow
    ...     procedure=${procedure}
    ...     device=${device}
    ...     protocol=${p}AP
    ...     timeout=${common_timeout}
    ...     verifier=${common_verifier}


EXPECT CONCURRENT FLOW${options:(\[.*?\]:|:)} ${device:\S+} ${p:(NG|XN|F1|E1|X2|M3|S1)}AP ${procedure:\S+}${rest_sentence}
    [Documentation]      As procedure following can be used:
    ...                  procedure_x   OR
    ...                  procedure_x,procedure_x   OR
    ...                  procedure_x,procedure_y   OR
    ...                  3*procedure_x   OR
    ...                  3*procedure_x,procedure_y,2*procedure_z
    ...                  Note: procedures may contain multiple messages and their order DOES NOT matter
    ...                  This keyword supports just catching all messages in any order.
    ...                  Verification of order is being left to user based on message content.
    ...                  Note 2: To be used only for concurrent procedures within SINGLE device.
    ...                  Note 3: ${common_verifier} variable can be used to apply common verifier (rather python one)
    ...                  Note 4: Set verifiers per message can be used to apply separate verifiers

    set concurrent flow
    ...     procedure=${procedure}
    ...     device=${device}
    ...     protocol=${p}AP
    ...     timeout=${common_timeout}
    ...     verifier=${common_verifier}


EXPECT FLOW${options:(\[.*?\]:|:)} UE${ue_id:\S+} ${p:(NR-RRC|RRC)} ${messages:\S+}${rest_sentence}
    [Documentation]     Keyword used to catch RRC/NR-RRC message.
    ...                 All messages must share the same protocol
    ...                 Following input can be used as ${messages}:
    ...                 singleMessage   OR
    ...                 singleMessage,secondMessage   OR
    ...                 2*singleMessage,secondMessage
    ...                 Note: procedures may contain multiple messages and their order matters
    ...                 (interleaving of procedures in this keyword is not supported)
    ...                 Note 2: ${common_verifier} variable can be used to apply common verifier (rather python one)
    ...                 Note 3: Set verifiers per message can be used to apply separate verifiers

    set flow
    ...     ${messages}
    ...     timeout=${common_timeout}
    ...     device=UE${ue_id}
    ...     verifier=${common_verifier}
    ...     protocol=${p}

EXPECT FLOW${options:(\[.*?\]:|:)} UE${ue_id:\S+} ${num:\d+} times ${p:(NR-RRC|RRC)} ${message:\w+}${rest_sentence}
    [Documentation]     To get messages from such flow use message names as 'message_1',..., 'message_n',
    ...                 Keyword depracated!!!!!!!!!! The same is supported by giving 2*massageName in generic UE keyword
    log
    ...    Keyword: 'EXPECT FLOW.* X times'\nThe same is supported by giving 2*massageName in generic UE keyword
    ...    level=WARN
    ...    console=${True}
    set flow
    ...     ${num}*${message}
    ...     timeout=${common_timeout}
    ...     device=UE${ue_id}
    ...     verifier=${common_verifier}
    ...     protocol=${p}

EXPECT FLOW${options:(\[.*?\]:|:)} ${t:(LTE|NR)}CELL${id:\S+} ${p:(NR-RRC|RRC)} ${messages:\S+}${rest_sentence}
    [Documentation]     Keyword used to catch single RRC/NR-RRC message sent by CELL, so SIB/MIB.
    ...                 Such messages are only available at Airphone/CUS when SIB changes.
    ...                 On IPHY SIBs can be read at any time.
    ...                 All messages must share the same protocol
    ...                 Following input can be used as ${messages}:
    ...                 singleMessage   OR
    ...                 singleMessage,secondMessage   OR
    ...                 2*singleMessage,secondMessage
    ...                 Note: ${common_verifier} variable can be used to apply common verifier (rather python one)
    ...                 Note 2: Set verifiers per message can be used to apply separate verifiers
    set flow
    ...     ${messages}
    ...     timeout=${common_timeout}
    ...     device=${t}CELL${id}
    ...     verifier=${common_verifier}
    ...     protocol=${p}

PASS FLOW${options:(\[.*?\]:|:)} ${keyword_name}
    pass flow
    ...     options=${options}
    ...     keyword_name=${keyword_name}

PASS CONCURRENT FLOW${options:(\[.*?\]:|:)} ${keyword_name}
    pass concurrent flow
    ...     options=${options}
    ...     keyword_name=${keyword_name}

FAIL FLOW${options:(\[.*?\]:|:)} ${keyword_name}
    fail flow
    ...     options=${options}
    ...     keyword_name=${keyword_name}

FAIL CONCURRENT FLOW${options:(\[.*?\]:|:)} ${keyword_name}
    fail concurrent flow
    ...     options=${options}
    ...     keyword_name=${keyword_name}


# Advanced mechanisms for keywords that can be run with continue on failure

Clear saved flows
    [Documentation]     Additional keyword to manually clear all saved flows in case of advanced flow re-use mechanism
    ...                 such as using flow with Run Keyword and Continue on Failure
    ...                 Note: after usage of the keyword, user cannot check the content of removed flows
    clear_flow_stack

#   Common settings for all flows

Set common verifier to: ${verifier_name}
    [Documentation]    Can be used to set common verifier to some value. It can be query-language-based verifier
    ...                or python verifier
    ...                Note: In log.html in EXPECT.* keyword it can be checked if and what verifier was applied for each
    ...                message in flow
    set suite variable    ${common_verifier}        ${verifier_name}

Unset common verifier
    [Documentation]    Can be used to switch off common verifier
    set suite variable    ${common_verifier}        ${None}

Set verifiers per message
    [Documentation]    Can be used to set dedicated verifier to some value. It can be query-language-based verifier
    ...                or python verifier.
    ...                Can apply many verifiers for different messages at once.
    ...                Single line format is:  message_name_with_optional_occurence:verifier
    ...                If applying per message occurrence, please use _1, _2, .. _n after messsage name
    ...                Possible inputs:
    ...                someMessage:some statement to check          OR
    ...                someOtherMessage_1:some statement to check
    ...                someOtherMessage_2:some statement to check
    ...                Note: In log.html in EXPECT.* keyword it can be checked if and what verifier was applied for each
    ...                message in flow
    ...                Note2 : Does not apply for already started flows
    [Arguments]         @{mesagge_and_verifier}
    set_per_message_verifier        @{mesagge_and_verifier}

Set verifiers per concurrent message
    [Documentation]    Can be used to set dedicated verifier to some value. It can be only python decorated verifier.
    ...                Callback func must be decorated with @message_verifier decarator
    ...                and must take as input (owner_alias, unparsed_owner_message) pararms.
    ...                Can apply many verifiers for different messages at once.
    ...                Single line format is:  protocol_message_name_with_optional_occurence:verifier
    ...                Can be used for entire message type, cannot set it by message occurence.
    ...                Possible inputs:
    ...                protocol_someMessage:some statement to check
    ...                Note: In log.html in EXPECT.* keyword it can be checked if and what verifier was applied for each
    ...                message in flow
    ...                Note2 : Does not apply for already started flows
    [Arguments]         @{mesagge_and_verifier}
    set_per_concurrent_message_verifier        @{mesagge_and_verifier}


Clear verifier per message
    [Documentation]    Can be used to unset dedicated verifier.
    ...                Can apply many messages at once.
    ...                If applying per message occurrence, please use _1, _2, .. _n after messsage name
    ...                Possible inputs:
    ...                someMessage          OR
    ...                someOtherMessage_1
    ...                someOtherMessage_2
    ...                Note: In log.html in EXPECT.* keyword it can be checked if and what verifier was applied for each
    ...                message in flow
    ...                Note2 : Does not apply for already started flows
    [Arguments]         @{messages_to_clear}
    clear_per_message_verifier      @{messages_to_clear}

Clear verifier per concurrent message
    [Documentation]    Can be used to unset dedicated verifier for concurrent messages.
    ...                Can apply many messages at once.
    ...                Verifier can be set per message type, not by per occurence
    ...                Possible inputs:
    ...                protocol_someMessage
    ...                Note: In log.html in EXPECT.* keyword it can be checked if and what verifier was applied for each
    ...                message in flow
    ...                Note2 : Does not apply for already started flows
    [Arguments]         @{messages_to_clear}
    clear_per_concurrent_message_verifier      @{messages_to_clear}


Clear all verifiers per message
    [Documentation]    Can be used to unset all dedicated verifiers.
    clear_all_verifiers


Set common timeout to: ${timeout}
    [Documentation]    Can be used to change common  timeout for all flows
    set suite variable    ${common_timeout}        ${timeout}

Unset common timeout to default
    [Documentation]    Can be used to reset common timeout to default 60s
    set suite variable    ${common_timeout}        60
